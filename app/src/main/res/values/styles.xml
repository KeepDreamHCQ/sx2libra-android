<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Sx2libra.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFeatureSettings">kern</item>
    </style>

    <style name="TextAppearance.Sx2libra.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
    </style>

    <style name="TextAppearance.Sx2libra.Secondary" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Sx2libra.Error" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TextAppearance.Sx2libra.Tab" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tab_unselected</item>
    </style>

    <style name="Widget.Sx2libra.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/icon_primary</item>
        <item name="android:padding">@dimen/libra_icon_button_padding</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Sx2libra.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconSize">22dp</item>
        <item name="itemIconTint">@color/bottom_navigation_item_colors</item>
        <item name="itemTextColor">@color/bottom_navigation_item_colors</item>
        <item name="itemBackground">@drawable/bg_bottom_navigation_item</item>
        <item name="itemRippleColor">@color/bottom_navigation_ripple_colors</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">4dp</item>
        <item name="itemHorizontalTranslationEnabled">false</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Sx2libra.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/tab_selected</item>
        <item name="tabIndicatorHeight">2dp</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabTextColor">@color/tab_text_colors</item>
        <item name="tabSelectedTextColor">@color/tab_selected</item>
        <item name="tabRippleColor">@color/tab_ripple_colors</item>
        <item name="tabTextAppearance">@style/TextAppearance.Sx2libra.Tab</item>
        <item name="tabPaddingStart">@dimen/libra_tab_padding</item>
        <item name="tabPaddingEnd">@dimen/libra_tab_padding</item>
        <item name="tabMinWidth">64dp</item>
        <item name="tabMode">scrollable</item>
    </style>

    <style name="Widget.Sx2libra.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_background</item>
        <item name="boxStrokeColor">@color/text_input_stroke_colors</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/libra_radius_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/libra_radius_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/libra_radius_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/libra_radius_field</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="prefixTextColor">@color/text_secondary</item>
    </style>

    <style name="Widget.Sx2libra.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Sx2libra.MaterialAlertDialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/libra_radius_dialog</item>
    </style>

    <style name="Widget.Sx2libra.DialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/libra_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">64dp</item>
    </style>

    <style name="ThemeOverlay.Sx2libra.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/libra_primary</item>
        <item name="colorSecondary">@color/libra_secondary</item>
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorAccent">@color/libra_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Sx2libra.MaterialAlertDialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Sx2libra.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Sx2libra.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Sx2libra.DialogButton</item>
    </style>

</resources>
